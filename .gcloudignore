.gcloudignore
.git
.gitignore

# Virtual environments & node modules
.venv/
node_modules/
web/node_modules/
web/dist/

# Python cache
__pycache__/
*.py[cod]

# Only top-level data cache directory (DuckDB & Bhavcopy). The two reference
# files are needed in the image and are re-included.
/data/*
!/data/nse_holidays_2026.json
!/data/nifty50_constituents.json

# Tests & temporary caches
.pytest_cache/
tests/
web/tests/

# Environment files
.env
.env.*
!.env.example

# Documentation & logs
docs/
*.log
